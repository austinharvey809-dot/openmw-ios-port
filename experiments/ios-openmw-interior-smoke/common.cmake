find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
get_filename_component(G2_REPO "${G2_ROOT}/../.." ABSOLUTE)
set(G2_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/g2-generated")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${G2_ROOT}/tools/bridge.py" --output "${G2_GENERATED}" COMMAND_ERROR_IS_FATAL ANY)
get_target_property(_osg_binary osg BINARY_DIR)
get_filename_component(_g2_osg_include "${_osg_binary}/../../include" ABSOLUTE)
set(_g2_esm)
foreach(_unit loadcell cellref loadacti loadcont loaddoor loadmisc loadligh)
  list(APPEND _g2_esm "${G2_REPO}/components/esm3/${_unit}.cpp")
endforeach()
add_library(g2-cell STATIC "${G2_ROOT}/src/Interior.cpp" "${G2_GENERATED}/MeshBridge.cpp" ${_g2_esm})
target_include_directories(g2-cell BEFORE PUBLIC "${_g2_osg_include}")
target_include_directories(g2-cell PUBLIC "${G2_ROOT}/src" "${G2_REPO}/experiments/ios-openmw-nif-render-smoke/real-model/src")
target_link_libraries(g2-cell PUBLIC g1c-texture g1d-dds)
target_compile_features(g2-cell PUBLIC cxx_std_20)
set_target_properties(g2-cell PROPERTIES CXX_EXTENSIONS OFF)
file(WRITE "${G2_GENERATED}/osg-include.txt" "${_g2_osg_include}\n")
