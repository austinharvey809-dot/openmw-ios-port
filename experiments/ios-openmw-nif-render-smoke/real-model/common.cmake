get_filename_component(G1D_REPO "${G1D_ROOT}/../../.." ABSOLUTE)
get_target_property(_osg_binary osg BINARY_DIR)
get_filename_component(_generated "${_osg_binary}/../../include" ABSOLUTE)
get_target_property(_osg_source osg SOURCE_DIR)
get_filename_component(_osg_root "${_osg_source}/../.." ABSOLUTE)
find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${G1D_ROOT}/tools/provenance.py" --check-dds "${_osg_root}/src/osgPlugins/dds/ReaderWriterDDS.cpp" COMMAND_ERROR_IS_FATAL ANY)
add_library(g1d-dds STATIC "${_osg_root}/src/osgPlugins/dds/ReaderWriterDDS.cpp")
target_include_directories(g1d-dds BEFORE PUBLIC "${_generated}" "${_osg_root}/include")
target_compile_definitions(g1d-dds PUBLIC OSG_LIBRARY_STATIC OPENTHREADS_STATIC)
target_link_libraries(g1d-dds PUBLIC osgDB osg OpenThreads)
add_library(g1d-model STATIC "${G1D_ROOT}/src/StaticModel.cpp")
target_include_directories(g1d-model PUBLIC "${G1D_ROOT}/src")
target_compile_features(g1d-model PUBLIC cxx_std_20)
set_target_properties(g1d-model PROPERTIES CXX_EXTENSIONS OFF)
target_link_libraries(g1d-model PUBLIC ${G1D_BASE} g1d-dds)
add_executable(openmw-real-model-check "${G1D_ROOT}/tests/model_check.cpp")
target_link_libraries(openmw-real-model-check PRIVATE g1d-model)
set_target_properties(openmw-real-model-check PROPERTIES CXX_EXTENSIONS OFF)
