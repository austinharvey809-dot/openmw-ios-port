# A cross CMAKE_SYSTEM_NAME does not imply CMAKE_SYSTEM_PROCESSOR. In
# particular, iOS may leave it empty even with -arch arm64 selected correctly.
# Derive from the explicit target, never CMAKE_HOST_SYSTEM_PROCESSOR.
function(g4_jpeg_platform_arguments output)
  set(_arguments)
  if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    if(NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
      message(FATAL_ERROR "G4 JPEG requires the explicit single arm64 iPhoneOS target")
    endif()
    string(TOLOWER "${CMAKE_OSX_SYSROOT}" _sdk)
    if(NOT _sdk MATCHES "(^|/)iphoneos([^/]*[.]sdk)?$" OR
        NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "18.0")
      message(FATAL_ERROR "G4 JPEG requires the selected iPhoneOS SDK and deployment target 18.0")
    endif()
    if(CMAKE_SYSTEM_PROCESSOR AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
      message(FATAL_ERROR "G4 JPEG target processor conflicts with arm64")
    endif()
    list(APPEND _arguments "-DCMAKE_SYSTEM_PROCESSOR:STRING=arm64")
  elseif(CMAKE_SYSTEM_PROCESSOR)
    list(APPEND _arguments "-DCMAKE_SYSTEM_PROCESSOR:STRING=${CMAKE_SYSTEM_PROCESSOR}")
  else()
    message(FATAL_ERROR "G4 JPEG requires an explicit/detected target processor")
  endif()
  foreach(_variable CMAKE_SYSTEM_NAME CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET)
    if(DEFINED ${_variable} AND NOT "${${_variable}}" STREQUAL "")
      list(APPEND _arguments "-D${_variable}:STRING=${${_variable}}")
    endif()
  endforeach()
  set(${output} "${_arguments}" PARENT_SCOPE)
endfunction()
